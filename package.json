{
  "name": "@pin/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && npm run test:content && npm run test:api",
    "test:e2e": "playwright test",
    "test:api": "node --conditions=react-server --import tsx --test tests/api-contract.mts",
    "format": "prettier --write .",
    "test:content": "node --import tsx --test tests/*.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.185.1",
    "server-only": "0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7",
    "@playwright/test": "^1.58.0",
    "prettier": "^3.9.6",
    "tsx": "^4.0.0"
  }
}
