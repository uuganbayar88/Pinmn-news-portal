{
  "openapi": "3.1.0",
  "info": {
    "title": "pin.mn Public Content API",
    "version": "1.0.0",
    "description": "Proposed contract for the separately deployed backend. Complete bounded catalog, published content only. No server implementation is included."
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local backend (planned)"
    }
  ],
  "paths": {
    "/api/v1/articles": {
      "get": {
        "operationId": "listArticles",
        "description": "Return all matching published articles. total equals articles.length. Unicode case-insensitive substring query across title, excerpt, body and source name. category and q combine. Pagination must be versioned before large archive deployment.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "society",
                "economy",
                "technology",
                "culture",
                "world"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "latest",
                "oldest"
              ],
              "default": "latest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful published-content response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleList"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable"
          }
        }
      }
    },
    "/api/v1/articles/{slug}": {
      "get": {
        "operationId": "getArticle",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful published-content response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Article"
                }
              }
            }
          },
          "404": {
            "description": "No published article with this slug"
          },
          "503": {
            "description": "Service temporarily unavailable"
          }
        }
      }
    },
    "/api/v1/digests/latest": {
      "get": {
        "operationId": "getLatestDigest",
        "description": "Return the latest published edition, preserving editorial order. All IDs must resolve in the catalog.",
        "responses": {
          "200": {
            "description": "Successful published-content response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Digest"
                }
              }
            }
          },
          "404": {
            "description": "No published daily briefing"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Article": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "society",
              "economy",
              "technology",
              "culture",
              "world"
            ]
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "source": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false
          },
          "keyPoints": {
            "minItems": 2,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 110
            }
          },
          "body": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string"
              },
              "alt": {
                "type": "string"
              },
              "credit": {
                "type": "string"
              }
            },
            "required": [
              "src",
              "alt",
              "credit"
            ],
            "additionalProperties": false
          },
          "visual": {
            "type": "string",
            "enum": [
              "library",
              "culture",
              "world",
              "science",
              "partnership"
            ]
          },
          "readingMinutes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "socialImage": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "excerpt",
          "category",
          "publishedAt",
          "source",
          "keyPoints",
          "body",
          "readingMinutes"
        ],
        "additionalProperties": false
      },
      "ArticleList": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "articles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "slug": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "excerpt": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "society",
                    "economy",
                    "technology",
                    "culture",
                    "world"
                  ]
                },
                "publishedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "name",
                    "url"
                  ],
                  "additionalProperties": false
                },
                "keyPoints": {
                  "minItems": 2,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 110
                  }
                },
                "body": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "image": {
                  "type": "object",
                  "properties": {
                    "src": {
                      "type": "string"
                    },
                    "alt": {
                      "type": "string"
                    },
                    "credit": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "src",
                    "alt",
                    "credit"
                  ],
                  "additionalProperties": false
                },
                "visual": {
                  "type": "string",
                  "enum": [
                    "library",
                    "culture",
                    "world",
                    "science",
                    "partnership"
                  ]
                },
                "readingMinutes": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "socialImage": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "id",
                "slug",
                "title",
                "excerpt",
                "category",
                "publishedAt",
                "source",
                "keyPoints",
                "body",
                "readingMinutes"
              ],
              "additionalProperties": false
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "articles",
          "total"
        ],
        "additionalProperties": false
      },
      "Digest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "articleIds": {
            "minItems": 7,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "date",
          "articleIds"
        ],
        "additionalProperties": false
      }
    }
  }
}
